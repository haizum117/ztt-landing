{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio&utm_campaign=stealth_s1",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=ig_reels&utm_medium=bio&utm_campaign=stealth_s1",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/?utm_source=yt_shorts&utm_medium=bio&utm_campaign=stealth_s1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
